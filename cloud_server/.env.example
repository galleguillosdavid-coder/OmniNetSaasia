# ==============================================================================
# OMNINET CLOUD PROXY & SAAS - VARIABLES DE ENTORNO
# Duplica este archivo como .env en tu servidor cloud (Render, Railway, Fly.io, etc.)
# ==============================================================================

# 1. Puerto del Servidor
PORT=9988

# 2. Clave Secreta de DeepSeek (¡NUNCA va dentro de OmniNet.exe!)
DEEPSEEK_API_KEY=sk-tu-clave-secreta-deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 3. Credenciales de tu Proyecto en Supabase (https://app.supabase.com)
# Ve a: Project Settings -> Configuration -> API
SUPABASE_URL=https://tu-proyecto-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
